# Gemini AI Configuration (Injected at runtime by AI Studio)
GEMINI_API_KEY=

# App Server Port
PORT=3000

# Application URL
APP_URL=

# Supabase Frontend Configuration (Public Anon Key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Backend Configuration (Server-Side Only - Never expose SERVICE_ROLE in frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
